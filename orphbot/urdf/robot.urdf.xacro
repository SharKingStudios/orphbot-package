<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="orphbot">
  <xacro:arg name="base_mesh" default="package://orphbot/meshes/orphbot_body.stl"/>
  <xacro:arg name="base_mesh_scale" default="0.001 0.001 0.001"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="$(arg base_mesh)" scale="$(arg base_mesh_scale)"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="$(arg base_mesh)" scale="$(arg base_mesh_scale)"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.004"/>
    </inertial>
  </link>
</robot>
